{
  "name": "yanju",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "YANJU_E2E_PREVIEW=1 playwright test",
    "setup:hooks": "git config --local core.hooksPath .githooks",
    "check:tokens": "node scripts/check-tokens.mjs",
    "verify": "pnpm check:tokens && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e:production"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.89",
    "@ai-sdk/openai-compatible": "^3.0.66",
    "@ai-sdk/react": "^4.0.136",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.133",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^4.0.0"
  }
}
